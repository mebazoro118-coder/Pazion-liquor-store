rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'mebazoro118@gmail.com' ||
        request.auth.token.email == 'admin@pazionliquor.com' ||
        exists(/databases/{database}/documents/adminUsers/$(request.auth.uid)) ||
        (exists(/databases/{database}/documents/users/$(request.auth.uid)) &&
         get(/databases/{database}/documents/users/$(request.auth.uid)).data.role in ['owner', 'admin', 'manager'])
      );
    }

    // Users collection
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // Products: public catalog, admin management
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Categories: public taxonomy, admin management
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Brands: public list, admin management
    match /brands/{brandId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Orders: customer creates & tracks, admin manages
    match /orders/{orderId} {
      allow create: if true; // Guest & member orders
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Inventory audit history
    match /inventoryHistory/{historyId} {
      allow read, write: if isAdmin();
    }

    // Coupons & Promotions
    match /coupons/{couponId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Delivery zones
    match /deliveryZones/{zoneId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Customer Tasting Reviews
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    // Global Store Settings & Website Content
    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Admin Users
    match /adminUsers/{adminId} {
      allow read, write: if isAdmin();
    }

    // Audit logs
    match /auditLogs/{logId} {
      allow read, write: if isAdmin();
    }

    // Administrative Notifications
    match /notifications/{notificationId} {
      allow read, update, delete: if isAdmin();
      allow create: if true; // Allow system triggers like customer order created
    }
  }
}
